# Normaliza line endings: o repositório guarda LF, o checkout no Windows converte.
* text=auto eol=lf

# Scripts de build do Windows precisam de CRLF para executar
*.bat text eol=crlf
gradlew.bat text eol=crlf

# Binarios: nunca diff nem conversao
*.jar binary
*.ttf binary
*.otf binary
*.png binary
*.jpg binary
*.so binary
*.apk binary

# Fontes vendorizadas (Termux, GPL-3.0) preservam como estao
app/src/main/java/com/termux/** -diff